<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Thangapulla ❤️</title>
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Sacramento&family=Quicksand:wght=400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #05020a;
            --bg-glow: #1a051d;
            --heart-red: #ff4d6d;
            --neon-pink: #ff007f;
            --neon-blue: #00f2ff;
            --neon-gold: #ffdf00;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: radial-gradient(circle at center, var(--bg-glow) 0%, var(--bg-dark) 100%);
            background-size: 200% 200%;
            animation: gradientBreath 8s ease infinite;
            color: white;
            font-family: 'Quicksand', sans-serif;
            overflow: hidden;
            height: 100vh;
            text-align: center;
            position: relative;
        }

        @keyframes gradientBreath {
            0%, 100% { background-position: 50% 50%; }
            50% { background-position: 50% 60%; }
        }

        /* --- Background Atmosphere Layer --- */
        #atmosphere-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .gold-neon-heart {
            position: absolute;
            color: var(--neon-gold);
            text-shadow: 0 0 5px #fff, 0 0 10px var(--neon-gold);
            opacity: 0;
            animation: fall linear forwards;
        }

        @keyframes fall {
            0% { transform: translateY(-10vh) rotate(0deg) scale(0.6); opacity: 0; }
            15% { opacity: 0.8; }
            90% { opacity: 0.8; }
            100% { transform: translateY(110vh) rotate(360deg) scale(1.2); opacity: 0; }
        }

        .floating-balloon {
            position: absolute;
            opacity: 0;
            white-space: nowrap;
            font-family: 'Pacifico', cursive;
            filter: drop-shadow(0 0 8px #ff007f);
            animation: floatUp linear forwards;
        }

        @keyframes floatUp {
            0% { transform: translateY(110vh) scale(0.8); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.7; }
            100% { transform: translateY(-10vh) scale(1.2); opacity: 0; }
        }

        /* --- Interactive Sparkle Hearts --- */
        .burst-heart {
            position: absolute;
            pointer-events: none;
            color: var(--heart-red);
            font-size: 20px;
            filter: drop-shadow(0 0 6px var(--neon-pink));
            animation: burstFloat 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
            z-index: 9999;
        }

        @keyframes burstFloat {
            0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
            100% { transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(1.4); opacity: 0; }
        }

        /* --- Page Layouts --- */
        .page {
            position: absolute;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s ease;
            z-index: 10;
        }

        .hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.95) translateY(20px);
        }

        /* --- Buttons --- */
        .btn {
            background: linear-gradient(135deg, rgba(255, 77, 109, 0.3) 0%, rgba(255, 0, 127, 0.15) 100%);
            border: 2px solid var(--heart-red);
            color: white;
            padding: 14px 38px;
            border-radius: 50px;
            font-size: 1.15rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            backdrop-filter: blur(8px);
            box-shadow: 0 0 15px rgba(255, 77, 109, 0.4);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .btn:hover {
            background: var(--heart-red);
            transform: scale(1.06);
            box-shadow: 0 0 30px var(--heart-red), 0 0 10px #fff;
        }

        .neon-title {
            font-family: 'Sacramento', cursive;
            font-size: 4.5rem;
            color: #fff;
            text-shadow: 0 0 7px #fff, 0 0 15px var(--neon-pink), 0 0 30px var(--neon-pink);
            margin-bottom: 15px;
        }

        .gold-neon-title {
            font-family: 'Sacramento', cursive;
            font-size: 4.5rem;
            font-weight: bold;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 7px #fff, 0 0 15px var(--neon-gold), 0 0 30px var(--neon-gold);
            margin-bottom: 20px;
        }

        .welcome-text {
            font-family: 'Pacifico', cursive;
            font-size: 3.5rem;
            color: #fff;
            margin-bottom: 20px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3), 0 0 20px var(--heart-red);
        }

        /* --- Distance Tracker --- */
        .distance-tracker {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 30px;
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.03);
            padding: 15px;
            border-radius: 20px;
            border: 1px solid rgba(0, 242, 255, 0.15);
            backdrop-filter: blur(5px);
        }

        .tracker-line-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            position: relative;
            margin-bottom: 8px;
        }

        .location-dot { font-size: 1rem; font-weight: bold; text-shadow: 0 0 8px var(--neon-blue); }

        .connecting-line {
            flex-grow: 1;
            height: 2px;
            background: linear-gradient(90deg, var(--neon-blue), var(--neon-pink), var(--neon-blue));
            margin: 0 15px;
            position: relative;
            box-shadow: 0 0 8px var(--neon-blue);
        }

        .pulsing-heart {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            color: var(--heart-red);
            font-size: 1.2rem;
            animation: heartPulse 1.2s infinite;
        }

        @keyframes heartPulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.3); }
        }

        .distance-caption { font-size: 0.9rem; color: #b5a9c6; }

        /* --- Scratch Card Layout --- */
        .scratch-card-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
            height: 320px;
            margin: 0 auto;
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.3);
            border-radius: 24px;
            overflow: hidden;
            display: none;
        }

        .letter-box {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 8, 25, 0.9);
            color: #fff;
            font-weight: 600;
            font-size: 1.05rem;
            text-shadow: 0 0 5px #fff, 0 0 10px var(--neon-pink);
            padding: 25px;
            line-height: 1.7;
            text-align: left;
            overflow-y: auto;
            border: 2px solid var(--neon-pink);
            border-radius: 24px;
            z-index: 1;
        }

        #scratch-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            cursor: pointer;
            border-radius: 24px;
        }

        .cursor { display: inline-block; width: 3px; background-color: var(--neon-pink); margin-left: 3px; animation: blink 0.8s infinite; }
        @keyframes blink { 50% { opacity: 0; } }

        /* --- Page 4: Memos --- */
        .memo-container {
            width: 100%;
            max-width: 480px;
            min-height: 180px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 5px;
        }

        .memo-card {
            background: rgba(20, 10, 25, 0.85);
            border: 2px solid var(--neon-blue);
            padding: 25px;
            border-radius: 24px;
            text-align: left;
            box-shadow: 0 10px 30px rgba(0,242,255,0.25);
            backdrop-filter: blur(12px);
            display: none;
            animation: memoFadeIn 0.7s ease forwards;
            width: 100%;
        }

        @keyframes memoFadeIn {
            from { opacity: 0; transform: scale(0.95) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .memo-card h4 { 
            color: var(--neon-blue); 
            margin-bottom: 12px; 
            font-size: 1.4rem;
            text-shadow: 0 0 8px var(--neon-blue);
        }
        .memo-card p { color: #ebdff7; font-size: 1.05rem; line-height: 1.6; }

        /* --- Page 5: Coupon Grid --- */
        .coupon-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            max-width: 450px;
            width: 100%;
            margin-top: 15px;
        }

        .coupon-card {
            background: rgba(255, 255, 255, 0.04);
            border: 2px dashed rgba(255, 0, 127, 0.4);
            padding: 20px 15px;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .coupon-card:hover {
            transform: scale(1.04);
            background: rgba(255, 0, 127, 0.1);
            border-color: var(--neon-pink);
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.3);
        }

        .coupon-card h3 { font-size: 1.1rem; color: var(--neon-gold); margin-bottom: 5px; }
        .coupon-card p { font-size: 0.85rem; color: #d0c4e0; }

        .coupon-card.claimed {
            border-style: solid;
            border-color: #00f2ff;
            background: rgba(0, 242, 255, 0.1);
        }
        .coupon-card.claimed h3 { color: #fff; text-decoration: line-through; }
        .coupon-card.claimed::after {
            content: 'CLAIMED ❤️';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg);
            background: var(--heart-red);
            color: white;
            font-size: 0.8rem;
            font-weight: bold;
            padding: 4px 10px;
            border-radius: 4px;
        }

        /* --- Page 6: Photo Deck Container --- */
        .deck-wrapper {
            position: relative;
            width: 260px;
            height: 340px;
            margin: 20px auto;
        }

        .neon-polaroid {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #ffffff;
            padding: 12px 12px 28px 12px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease, box-shadow 0.3s;
            cursor: grab;
            border: 1px solid rgba(255, 255, 255, 0.2);
            outline: 4px solid rgba(255, 0, 127, 0.25);
            transform-origin: center bottom;
        }
        .neon-polaroid:active { cursor: grabbing; }

        .neon-polaroid img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 4px;
            pointer-events: none;
        }

        .frame-caption {
            font-family: 'Pacifico', cursive;
            color: #1a051d;
            font-size: 1rem;
            margin-top: 14px;
            text-align: center;
            pointer-events: none;
        }

        .neon-polaroid.swiped {
            transform: translate(250px, -80px) rotate(45deg) scale(0.8) !important;
            opacity: 0;
            pointer-events: none;
        }

        /* --- Bottom Ticker Style --- */
        .bottom-ticker {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(5, 2, 10, 0.8);
            border-top: 1px solid rgba(255, 0, 127, 0.2);
            padding: 6px 0;
            overflow: hidden;
            white-space: nowrap;
            z-index: 100;
        }
        .ticker-content {
            display: inline-block;
            font-size: 0.85rem;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.5);
            text-shadow: 0 0 5px var(--neon-pink);
            animation: tickerMove 25s linear infinite;
        }
        @keyframes tickerMove {
            0% { transform: translate3d(100%, 0, 0); }
            100% { transform: translate3d(-100%, 0, 0); }
        }

    </style>
</head>
<body>

    <div id="atmosphere-container"></div>

    <audio id="romantic-bg-track" preload="auto" loop></audio>

    <div class="page" id="page1">
        <h1 class="welcome-text">Hey chloooo ✨</h1>
        <button class="btn" onclick="initializeWebExperience()">ulla polamaa👀😋</button>
    </div>

    <div class="page hidden" id="page2">
        <h1 class="gold-neon-title">ONE YEAR OF US</h1>
        
        <div class="distance-tracker">
            <div class="tracker-line-container">
                <span class="location-dot">Madurai📍</span>
                <div class="connecting-line">
                    <div class="pulsing-heart">❤️</div>
                </div>
                <span class="location-dot">📍Dindigul</span>
            </div>
            <div class="distance-caption">No matter the distance, always in my heart ✨</div>
        </div>
        
        <button class="btn" onclick="nextPage(3)">letter padikalama? 💌</button>
    </div>

    <div class="page hidden" id="page3">
        <h1 class="neon-title" style="font-size: 3rem; margin-bottom: 25px;">A Gift For You...</h1>
        
        <button class="btn" id="open-letter-btn" onclick="setupScratchCard()">Scratch Layer Unlock 🔓</button>

        <div class="scratch-card-wrapper" id="scratch-wrapper-el">
            <canvas id="scratch-canvas"></canvas>
            <div class="letter-box" id="letter-box-el">
                <span id="letter-content"></span><span class="cursor" id="letter-cursor">|</span>
            </div>
        </div>

        <button class="btn hidden" id="next-to-memos" onclick="nextPage(4)">aduthu povom ahhh 😋</button>
    </div>

    <div class="page hidden" id="page4">
        <h1 class="neon-title" style="font-size: 2.8rem; text-shadow: 0 0 15px var(--neon-blue); color: #fff;">Konjo memos papom ah</h1>
        
        <div class="memo-container">
            <div class="memo-card" id="memo1">
                <h4>Memo 1: June 16 💘</h4>
                <p>naa unaku first confess panna nall rombha spl laa best day in my life</p>
            </div>
            <div class="memo-card" id="memo2">
                <h4>Memo 2: June 20 🥰</h4>
                <p>naa unna first hands la kiss panna day laa namma kai pudichu nadanthu ponathu apro nee en tiny finger pudichu nadanthu vanthathu hehehe</p>
            </div>
            <div class="memo-card" id="memo3">
                <h4>Memo 3: June 28 💋✨</h4>
                <p>namma first date concert rombha rombha special namma first kiss antha feel ippovu irruku kiss adichutu shy ah irrunthom hehehe first time nammaloda lips touch pannathu haiyooo</p>
            </div>
            <div class="memo-card" id="memo4">
                <h4>Memo 4: Our Annual Day 🎬</h4>
                <p>namma annual day appo antha piller pakathula ukanthu pesunathu apro naa un idupa thattathu hehee 🤫❤️</p>
            </div>
            <div class="memo-card" id="memo5">
                <h4>Memo 5: Movie Time History 🍿</h4>
                <p>namma frnds ah irruntha appo antha movie marakave mudiyathu! appo naa love pannen nee pannala, ana dhivya akka sonnanga neenga senthuruvinganu... ippo senthutomm! 🥹🧿❤️</p>
            </div>
        </div>

        <button class="btn" id="memo-flow-btn" onclick="cycleMemos()">Click to open next memo ✨</button>
        <button class="btn hidden" id="to-coupons-btn" onclick="nextPage(5)">Innoru surprise iruku 👀💛</button>
    </div>

    <div class="page hidden" id="page5">
        <h1 class="gold-neon-title" style="font-size: 3.2rem;">YOUR COUPONS</h1>
        <p style="color: #ebdff7; font-size: 0.95rem; max-width: 400px; margin-bottom: 10px;">Tap a coupon whenever you want to redeem it with your Thangoo! 😉</p>

        <div class="coupon-grid">
            <div class="coupon-card" onclick="claimCoupon(this)">
                <h3>Long Drive 🚗</h3>
                <p>Valid for one sudden late-night drive.</p>
            </div>
            <div class="coupon-card" onclick="claimCoupon(this)">
                <h3>Ice Cream Treat 🍦</h3>
                <p>Redeemable for late-night sweet cravings.</p>
            </div>
            <div class="coupon-card" onclick="claimCoupon(this)">
                <h3>Argument Win 🤫</h3>
                <p>Instantly win any small silly fight.</p>
            </div>
            <div class="coupon-card" onclick="claimCoupon(this)">
                <h3>Giant Hug 🤗</h3>
                <p>Get a tight non-stop hug whenever needed.</p>
            </div>
        </div>

        <button class="btn" style="border-color: var(--neon-blue);" onclick="nextPage(6); initPhotoDeck();">Kadaisi ah onnu... 👀📸</button>
    </div>

    <div class="page hidden" id="page6">
        <h1 class="neon-title" style="font-size: 2.5rem; text-shadow: 0 0 15px var(--neon-pink); margin-bottom: 5px;">Our Memory Box Room</h1>
        <p style="color: #ebdff7; font-size: 0.9rem; margin-bottom: 5px;">Click or tap the top picture to toss it and reveal the next memory... 📸✨</p>

        <div class="deck-wrapper" id="photo-deck">
            <div class="neon-polaroid" id="photo1">
                <img src="654419075_965873229435523_5798277111930049970_n.jpg" alt="Memory 1">
                <div class="frame-caption">En Thangapulla 💖</div>
            </div>
            <div class="neon-polaroid" id="photo2">
                <img src="657583609_1085857157096815_7678327551533153094_n.jpg" alt="Memory 2">
                <div class="frame-caption">My Safe Place 🥰</div>
            </div>
            <div class="neon-polaroid" id="photo3">
                <img src="717675515_874982508328931_4946456510356096275_n.jpg" alt="Memory 3">
                <div class="frame-caption">Cute Moments 🤫</div>
            </div>
            <div class="neon-polaroid" id="photo4">
                <img src="715276209_2058026921729876_7927233764022316469_n.jpg" alt="Memory 4">
                <div class="frame-caption">Mdu and Blr Loop 📍</div>
            </div>
        </div>

        <button class="btn" style="border-color: var(--neon-gold); margin-top: 5px;" onclick="resetPhotoDeck()">Bring Cards Back 🔄</button>
        <p style="margin-top: 10px; font-family: 'Pacifico'; font-size: 1.3rem; color: var(--heart-red); text-shadow: 0 0 10px rgba(255,77,109,0.3);">Happy Anniversary Baby! 💛✨</p>
    </div>

    <div class="bottom-ticker">
        <div class="ticker-content">
            Forever yours di thangoo ❤️ • Happy 1 Year Anniversary Baby ✨ • Madurai to Dindigul connected by heart 📍 • Ice katti kuruvi namma song loop mode 🎵 • Love you infinity chloooo 💋
        </div>
    </div>

    <script>
        // --- SECURE INLINE STRING AUDIO ASSIGNMENT STRATEGY ---
        const exactSongPath = "Ice Katti Kuruvi - Video Song  D Block  Arulnithi, Avantika  Eruma Saani Vijay  Ron Ethan Yohann.mp3";
        const musicTrack = document.getElementById('romantic-bg-track');
        if (musicTrack) {
            musicTrack.src = encodeURI(exactSongPath); // Encodes complex string spaces safely
        }

        // --- Atmosphere Engine ---
        const atmosphere = document.getElementById('atmosphere-container');
        const floatingPool = ['🎈', '🌸', 'thangoo ❤️', 'chloo ✨', 'baby 💘', 'thangapulla ✨'];

        function createNeonGoldHeart() {
            const heart = document.createElement('div');
            heart.classList.add('gold-neon-heart');
            heart.innerHTML = Math.random() > 0.25 ? '💛' : '✨';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.fontSize = (Math.random() * 12 + 15) + 'px';
            heart.style.animationDuration = (Math.random() * 3.5 + 2.5) + 's';
            atmosphere.appendChild(heart);
            setTimeout(() => heart.remove(), 6000);
        }
        setInterval(createNeonGoldHeart, 180);

        function createFloatingBalloon() {
            const balloon = document.createElement('div');
            balloon.classList.add('floating-balloon');
            const randomAsset = floatingPool[Math.floor(Math.random() * floatingPool.length)];
            balloon.innerHTML = randomAsset;
            
            if (randomAsset.length > 2) {
                balloon.style.color = '#fff';
                balloon.style.textShadow = '0 0 8px #ff007f';
                balloon.style.fontSize = '1.1rem';
            } else {
                balloon.style.fontSize = (Math.random() * 15 + 20) + 'px';
            }
            balloon.style.left = Math.random() * 90 + 'vw';
            balloon.style.animationDuration = (Math.random() * 4 + 5) + 's';
            atmosphere.appendChild(balloon);
            setTimeout(() => balloon.remove(), 9000);
        }
        setInterval(createFloatingBalloon, 750);

        // --- Interactive Touch-to-Burst Hearts ---
        function createBurstHeart(x, y) {
            const heart = document.createElement('div');
            heart.classList.add('burst-heart');
            heart.innerHTML = Math.random() > 0.5 ? '❤️' : '💖';
            heart.style.left = x + 'px';
            heart.style.top = y + 'px';

            const angle = Math.random() * Math.PI * 2;
            const distance = Math.random() * 80 + 40;
            heart.style.setProperty('--x', Math.cos(angle) * distance + 'px');
            heart.style.setProperty('--y', Math.sin(angle) * distance - 50 + 'px');

            document.body.appendChild(heart);
            setTimeout(() => heart.remove(), 1000);
        }

        window.addEventListener('click', (e) => {
            if(e.target.tagName === 'BUTTON' || e.target.tagName === 'CANVAS' || e.target.closest('.coupon-card') || e.target.closest('.neon-polaroid')) return;
            for(let i=0; i<6; i++) { createBurstHeart(e.clientX, e.clientY); }
        });

        window.addEventListener('touchmove', (e) => {
            if(e.target.tagName === 'CANVAS' || e.target.closest('.deck-wrapper')) return; 
            if(Math.random() > 0.25) return; 
            createBurstHeart(e.touches[0].clientX, e.touches[0].clientY);
        });

        // --- Entry Action ---
        function initializeWebExperience() {
            if (musicTrack) {
                musicTrack.play().catch(error => console.log("Autoplay block handled safely:", error));
            }
            nextPage(2);
        }

        function nextPage(num) {
            document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
            document.getElementById('page' + num).classList.remove('hidden');
        }

        // --- Coupon System Claim Logic ---
        function claimCoupon(card) {
            card.classList.toggle('claimed');
            const box = card.getBoundingClientRect();
            for(let i=0; i<8; i++) {
                createBurstHeart(box.left + (box.width / 2), box.top + (box.height / 2));
            }
        }

        // --- Interactive Photo Frame Deck Engine ---
        const angles = [-4, 3, -2, 5]; 
        let deckCards = [];

        function initPhotoDeck() {
            deckCards = Array.from(document.querySelectorAll('.neon-polaroid'));
            deckCards.forEach((card, index) => {
                card.classList.remove('swiped');
                card.style.zIndex = deckCards.length - index;
                card.style.transform = `translate(0, 0) rotate(${angles[index % angles.length]}deg) scale(${1 - index * 0.03})`;
                
                card.onclick = function(e) {
                    if (card.style.zIndex == deckCards.length) {
                        const box = card.getBoundingClientRect();
                        for(let i=0; i<10; i++) { createBurstHeart(box.left + (box.width/2), box.top + (box.height/2)); }
                        
                        card.classList.add('swiped');
                        setTimeout(() => {
                            deckCards.forEach(c => {
                                if (parseInt(c.style.zIndex) < parseInt(card.style.zIndex)) {
                                    c.style.zIndex = parseInt(c.style.zIndex) + 1;
                                }
                            });
                            card.style.zIndex = 1;
                        }, 300);
                    }
                };
            });
        }

        function resetPhotoDeck() {
            initPhotoDeck();
        }

        // --- Virtual Scratch Card Engine ---
        function setupScratchCard() {
            document.getElementById('open-letter-btn').style.display = 'none';
            const wrapper = document.getElementById('scratch-wrapper-el');
            wrapper.style.display = 'block';

            const canvas = document.getElementById('scratch-canvas');
            const ctx = canvas.getContext('2d');
            
            canvas.width = wrapper.offsetWidth;
            canvas.height = wrapper.offsetHeight;

            ctx.fillStyle = '#ff007f';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 20px Quicksand';
            ctx.textAlign = 'center';
            ctx.fillText('Scratch here to read... 💌', canvas.width / 2, canvas.height / 2);

            let isDrawing = false;
            document.body.style.userSelect = 'none';

            function scratch(e) {
                if (!isDrawing) return;
                
                const rect = canvas.getBoundingClientRect();
                const clientX = e.clientX || (e.touches && e.touches[0].clientX);
                const clientY = e.clientY || (e.touches && e.touches[0].clientY);
                
                const x = clientX - rect.left;
                const y = clientY - rect.top;

                ctx.globalCompositeOperation = 'destination-out';
                ctx.beginPath();
                ctx.arc(x, y, 32, 0, Math.PI * 2);
                ctx.fill();
                
                if(Math.random() > 0.6) { createBurstHeart(clientX, clientY); }
                checkScratchPercentage();
            }

            canvas.addEventListener('mousedown', () => isDrawing = true);
            canvas.addEventListener('touchstart', () => isDrawing = true);
            window.addEventListener('mouseup', () => isDrawing = false);
            window.addEventListener('touchend', () => isDrawing = false);
            canvas.addEventListener('mousemove', scratch);
            canvas.addEventListener('touchmove', scratch);

            function checkScratchPercentage() {
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const pixels = imageData.data;
                let cleared = 0;

                for (let i = 3; i < pixels.length; i += 4) {
                    if (pixels[i] === 0) cleared++;
                }

                const percentage = (cleared / (pixels.length / 4)) * 100;
                
                if (percentage > 40) {
                    canvas.style.display = 'none';
                    document.body.style.userSelect = 'auto';
                    startTypingLetter();
                }
            }
        }

        // --- Typewriter Letter Text Loop ---
        const letterText = "Hey thangapulla, miss you so much seekarom meet pannuvom inniku namma special day laa 1st year anniversary evalo sanda potrukom evalo konjirukom evolo pesirukom...\n\nLast year ithe nall nee keta appo nervous ah starting la love pannalanu sonnen niyabagom irrukaa apro konjo nerathula ehh amaa love you di sonnen.\n\nThey day i confessed was really really special. nee na enaku avalo pudikum avaloo, namma evalo sanda potalu onna irrupom enna vitu la pogatha en kudave iruu love you alot.\n\nForever yours di thangoo ❤️";
        let textIndex = 0;

        function startTypingLetter() {
            typeLetter();
        }

        function typeLetter() {
            if (textIndex < letterText.length) {
                let char = letterText.charAt(textIndex);
                if (char === "\n") {
                    document.getElementById('letter-content').innerHTML += "<br>";
                } else {
                    document.getElementById('letter-content').innerHTML += char;
                }
                textIndex++;
                setTimeout(typeLetter, 45);
                const box = document.getElementById('letter-box-el');
                box.scrollTop = box.scrollHeight;
            } else {
                document.getElementById('letter-content').innerHTML += "";
                document.getElementById('letter-cursor').style.display = 'none';
                document.getElementById('next-to-memos').classList.remove('hidden');
            }
        }

        // --- Step-by-Step Memo Cycle Logic ---
        let currentMemoStep = 0;
        const totalMemos = 5; 

        function cycleMemos() {
            currentMemoStep++;
            document.querySelectorAll('.memo-card').forEach(card => card.style.display = 'none');
            
            if (currentMemoStep <= totalMemos) {
                document.getElementById('memo' + currentMemoStep).style.display = 'block';
                
                if (currentMemoStep === totalMemos) {
                    document.getElementById('memo-flow-btn').style.display = 'none';
                    document.getElementById('to-coupons-btn').classList.remove('hidden');
                } else {
                    document.getElementById('memo-flow-btn').innerText = 'Click to open next memo ✨';
                }
            }
        }
    </script>
</body>
</html>
